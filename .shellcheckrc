# ShellCheck configuration for open-lakehouse.
#
# SC2155 — "Declare and assign separately to avoid masking return values."
# This repo's shell (the `lakehouse` CLI in particular) uses the `local x=$(cmd)`
# idiom pervasively for command substitutions whose exit status is never consulted
# (e.g. `local port=$(get_spark_port)`), so the masking SC2155 warns about is benign
# here. Accepting it as house style keeps the `shellcheck --severity=warning` gate in
# .pre-commit-config.yaml green while still catching every genuine issue. Real
# correctness findings (word splitting, quoting, parse errors, dead code) are fixed
# in the code rather than suppressed.
disable=SC2155
